# Домен сайта (DNS A-запись → IP сервера)
DOMAIN=traksos.ru
# Caddy (внутренняя сеть Docker) передаёт реальный IP для ограничения SMS
TRUST_PROXY=true
# Пароль базы — длинный случайный
DB_PASSWORD=
# Секрет для токенов: openssl rand -hex 32
APP_SECRET=
# РОВНО ОДИН основной администратор, только на VPS в .env.
# Сам по себе SMS-код НЕ выдаёт роль администратора; bootstrap — локальная операция.
ADMIN_PHONES=+7XXXXXXXXXX
# Единственный разрешённый номер модератора (роль выдаёт администратор).
MODERATOR_PHONES=
# Запасной контакт для ручной процедуры восстановления. НЕ является логином/админом.
RECOVERY_CONTACT_PHONE=

# SMS только регистрация и восстановление пароля. log — строго демонстрационный режим.
SMS_PROVIDER=log
SMSRU_API_ID=

# Пуши RuStore (вызов мастеру как звонок)
PUSH_PROVIDER=log
RUSTORE_PROJECT_ID=
RUSTORE_SERVICE_TOKEN=

# Оплата: mock до проверки схемы юристом и бухгалтером; включается в «Настройках площадки»
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_AGENT_ID=
YOOKASSA_PAYOUT_KEY=
