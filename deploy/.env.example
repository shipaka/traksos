# Домен сайта (DNS A-запись → IP сервера)
DOMAIN=traksos.ru
# Caddy (внутренняя сеть Docker) передаёт реальный IP для ограничения SMS
TRUST_PROXY=true
# Пароль базы — длинный случайный
DB_PASSWORD=
# Секрет для токенов: openssl rand -hex 32
APP_SECRET=
# РОВНО ОДИН основной администратор, только на VPS в .env.
# Сам по себе SMS-код НЕ выдаёт роль администратора; bootstrap — локальная операция.
ADMIN_PHONES=+7XXXXXXXXXX
# Единственный разрешённый номер модератора (роль выдаёт администратор).
MODERATOR_PHONES=
# Один изначально разрешённый страховой агент, +79XXXXXXXXX, вводится приватно на VPS.
# Номер нельзя использовать для других типов аккаунтов.
INSURER_PRIMARY_PHONE=
# Запасной контакт для ручной процедуры восстановления. НЕ является логином/админом.
RECOVERY_CONTACT_PHONE=

# SMS только регистрация и восстановление пароля. log — строго демонстрационный режим.
SMS_PROVIDER=log
SMSRU_API_ID=
# Режим по умолчанию: sms. Входящий звонок клиенту (call) включать ТОЛЬКО
# после согласования интерфейса и тестового Flash Call через SMS.ru.
AUTH_VERIFICATION_CHANNEL=sms

# Пуши RuStore (вызов мастеру как звонок)
PUSH_PROVIDER=log
RUSTORE_PROJECT_ID=
RUSTORE_SERVICE_TOKEN=

# Оплата: mock до проверки схемы юристом и бухгалтером; включается в «Настройках площадки»
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_AGENT_ID=
YOOKASSA_PAYOUT_KEY=

# Необязательный ключ Яндекс Погоды для сезонного Android splash. Только на VPS; без ключа сезонный фон работает офлайн.
# Ключ никогда не копировать в GitHub, APK или переписку.
YANDEX_WEATHER_API_KEY=

# Необязательная отправка уведомлений о технических обращениях в ЗАКРЫТЫЙ HTTPS-канал.
# Уведомление содержит только UUID обращения, категорию, дату и ссылку на админку.
# Телефон, имя и описание не отправляются. Без обоих параметров остаётся внутренняя очередь.
# Только на VPS; не коммитить реальный URL/токен в GitHub.
DEVELOPER_REPORT_WEBHOOK_URL=
DEVELOPER_REPORT_WEBHOOK_SECRET=
