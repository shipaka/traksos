# Copy to deploy/.env.sandbox; keep it outside Git and never reuse primary APP_SECRET.
# This file is used by ONLY sandbox-app; prod SMS/payment tokens MUST NOT be here.
APP_SECRET=SET_UNIQUE_RANDOM_64_HEX_CHAR_SECRET
# This value MUST match SANDBOX_SHARED_SECRET in prod deploy/.env.
SANDBOX_SHARED_SECRET=SET_ANOTHER_64_HEX_CHAR_SECRET
# No real phones, SMS, payment credentials, user data or supplier secrets.
SMS_PROVIDER=log
PUSH_PROVIDER=log
PAYMENT_PROVIDER=mock
SANDBOX_INSTANCE=true
ADMIN_PHONES=+79000000001
MODERATOR_PHONES=+79000000005
