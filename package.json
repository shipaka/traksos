{
  "name": "traksos",
  "private": true,
  "description": "ТракSOS — маркетплейс выездной помощи грузовикам, СПб и ЛО",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "test": "npm -w server test",
