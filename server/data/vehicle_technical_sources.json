  "driverTips": [
    {
      "id": "brakes",
      "title": "Неисправность тормозов и EBS",
      "category": "truck",
      "tags": [
        "EBS",
        "ABS",
        "тормоза"
      ],
      "body": "При сообщении EBS/ABS оцените управляемость и торможение, остановитесь в безопасном месте. Не отключайте защитные системы и не продолжайте движение, если торможение ненадёжно. Зафиксируйте код ошибки и тип прицепа; вызовите профильного специалиста.",
      "priority": "critical",
      "professionalDetail": false
    },
    {
      "id": "charging",
      "title": "Пропала зарядка генератора",
      "category": "truck",
      "tags": [
        "генератор",
        "АКБ",
        "питание"
      ],
      "body": "Остановитесь в безопасном месте и проверьте индикаторы напряжения без вмешательства в проводку. Оцените необходимость эвакуатора/выездного электрика. Не замыкайте силовые контакты и не разбирайте генератор на обочине.",
      "priority": "high",
      "professionalDetail": false
    },
    {
      "id": "cooling",
      "title": "Перегрев двигателя",
      "category": "truck",
      "tags": [
        "антифриз",
        "температура",
        "охлаждение"
      ],
      "body": "Остановитесь там, где безопасно. Не открывайте крышку расширительного бачка горячего двигателя: возможен ожог. Зафиксируйте температуру и признаки утечек, обратитесь к специалисту.",
      "priority": "critical",
      "professionalDetail": false
    },
    {
      "id": "adblue",
      "title": "Ошибка SCR/AdBlue",
      "category": "truck",
      "tags": [
        "AdBlue",
        "SCR",
        "NOx"
      ],
      "body": "Запишите сообщения панели и код ошибки, проверьте уровень AdBlue по штатному индикатору. Не обходите экологическую систему и не пытайтесь сбросить ошибку без диагностики; при ограничении мощности запросите консультацию.",
      "priority": "normal",
      "professionalDetail": false
    },
    {
      "id": "trailer_lights",
      "title": "Не работает освещение прицепа",
      "category": "trailer",
      "tags": [
        "свет",
        "розетка",
        "прицеп"
      ],
      "body": "Остановитесь безопасно и проверьте наружный свет визуально. Если не работают габариты/стоп-сигналы, оцените возможность безопасного движения и обратитесь к выездному электрику. Не делайте перемычки в разъёме наугад.",
      "priority": "high",
      "professionalDetail": false
    },
    {
      "id": "tyre",
      "title": "Повреждение шины",
      "category": "truck",
      "tags": [
        "колесо",
        "шина",
        "давление"
      ],
      "body": "При повреждении шины не выполняйте опасную замену на проезжей части. Установите предупреждение по ПДД, покиньте опасную зону и вызовите шиномонтаж или эвакуатор. Не проверяйте рукой утечку воздуха на накачанной грузовой шине.",
      "priority": "high",
      "professionalDetail": false
    }
  ],
